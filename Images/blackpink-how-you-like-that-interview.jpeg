tbody tr:nth-of-type(even){background-color:rgba(
          224,224,224,
          0.5
        );}/*!sc*/
tbody td{--border-color__token-name:"colors.foundation.menu.dividers";border-color:rgba(224,224,224,1);border-width:1px 0 0 0;border-style:solid;}/*!sc*/
tbody td:last-of-type{border-right:0;}/*!sc*/
