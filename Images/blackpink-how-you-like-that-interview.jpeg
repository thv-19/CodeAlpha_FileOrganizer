ing Apparel Human Person Skirt Footwear Leisure Activities and Dance Pose","caption":"","contentType":"photo","credit":"","id":"5ef5c7b196e2923cb3e2316d","sources":{"sm":{"aspectRatio":"1:1","width":360,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_360,c_limit\u002FBlackPink.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_120,c_limit\u002FBlackPink.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_240,c_limit\u002FBlackPink.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_320,c_limit\u002FBlackPink.jpg 320w"},"md":{"aspectRatio":"1:1","width":1024,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_1024,c_limit\u002FBlackPink.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_120,c_limit\u002FBlackPink.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_240,c_limit\u002FBlackPink.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_320,c_limit\u002FBlackPink.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_640,c_limit\u002FBlackPink.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_768,c_limit\u002FBlackPink.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F1:1\u002Fw_960,c_limit\u002FBlackPink.jpg 960w"},"lg":{"aspectRatio":"2:3","width":1280,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F2:3\u002Fw_1280,c_limit\u002FBlackPink.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b196e2923cb3e2316d\u002F2:3\u002Fw_120,c_limit\u