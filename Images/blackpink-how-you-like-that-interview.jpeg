, Dress, and Long Sleeve","filename":"New Korean Influencers.jpg","metadata":{"contentType":"photo"},"aspectRatios":{"master":{"url":"https:\u002F\u002Fgp-prd-global-clips-s3.s3.amazonaws.com\u002Fpublic\u002Fvogueuk-services\u002Fproduction\u002F2020\u002F05\u002F29\u002F5ed11c19dea155898652a66e_New%20Korean%20Influencers.jpg","width":1944,"height":1268,"format":"JPEG"},"3:2":{"url":null,"width":1902,"height":1268,"format":null},"3:4":{"url":null,"width":951,"height":1268,"format":null},"2:3":{"url":null,"width":844,"height":1266,"format":null},"16:9":{"url":null,"width":1936,"height":1089,"format":null},"4:3":{"url":null,"width":1688,"height":1266,"format":null},"1:1":{"url":null,"width":1268,"height":1268,"format":null}},"collection":"photos","modelName":"photo","meta":{"modelName":"photo"}}]},"galleries":{},"meta":{"modelName":"gallery"},"contributors":{"":[{"name":"Naomi Pike","url":"profile\u002Fnaomi-pike","type":"AUTHOR"}]},"items":[],"modelName":"gallery"},"pageSize":4}}}],["p","It’s during the hectic preparations running up to the release that Jennie, Jisoo, Lisa and Rosé, standing on the precipice of an exciting new life chapter, take to email to discuss their fame, creative processes, and being undisputed ",["a",{"href":"https:\u002F\u002Fwww.vogue.co.uk\u002Fmiss-vogue\u002Farticle\u002Fblackpink-biggest-k-pop-girl-band","target":"_blank","isExternal":false},"global powerhouses"],"."],["native-ad",{"position":"in-content","shouldDisplayLabel":true}],["inline-embed",{"props":{"dangerousCaption":"","dangerousCredit":"","image":{"id":"5ef5c7b296e2923cb3e2316e","altText":"Image may contain Clothing Apparel Human Person Footwear and Shoe","contentType":"photo","sources":{"sm":{"width":320,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_320,c_limit\u002FPic%203.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_120,c_limit\u002FPic%203.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_240,c_limit\u002FPic%203.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_320,c_limit\u002FPic%203.jpg 320w","height":153},"md":{"width":640,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_640,c_limit\u002FPic%203.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_120,c_limit\u002FPic%203.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_240,c_limit\u002FPic%203.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_320,c_limit\u002FPic%203.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_640,c_limit\u002FPic%203.jpg 640w","height":306},"lg":{"width":960,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_960,c_limit\u002FPic%203.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_120,c_limit\u002FPic%203.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_240,c_limit\u002FPic%203.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_320,c_limit\u002FPic%203.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_640,c_limit\u002FPic%203.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_768,c_limit\u002FPic%203.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_960,c_limit\u002FPic%203.jpg 960w","height":459},"xl":{"width":1200,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_1200,c_limit\u002FPic%203.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_120,c_limit\u002FPic%203.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_240,c_limit\u002FPic%203.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_320,c_limit\u002FPic%203.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_640,c_limit\u002FPic%203.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_768,c_limit\u002FPic%203.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_960,c_limit\u002FPic%203.jpg 960w","height":574},"xxl":{"width":1600,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_1600,c_limit\u002FPic%203.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_120,c_limit\u002FPic%203.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_240,c_limit\u002FPic%203.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_320,c_limit\u002FPic%203.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_640,c_limit\u002FPic%203.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_768,c_limit\u002FPic%203.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_960,c_limit\u002FPic%203.jpg 960w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_1280,c_limit\u002FPic%203.jpg 1280w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b296e2923cb3e2316e\u002Fmaster\u002Fw_1600,c_limit\u002FPic%203.jpg 1600w","height":765}}}},"level":"block","ref":"5ef5c7b296e2923cb3e2316e","type":"image"}],["ad",{"position":"mid-content"}],["h2","Let’s discuss “How You Like That” — how would you describe this new track?"],["p","“This single is a more intense hip-hop song but at the same time maintains the original colour and personality of Blackpink. The message talks about [how] in any given situation, we will not lose confidence and will rise, despite the circumstances we’re in.”"],["journey-inline-newsletter",{"newsletterType":"slim-newsletter","newsletters":[]}],["inline-newsletter",{"newsletterType":"slim-newsletter","newsletters":[]}],["h2","In your new reality show, ",["em","24\u002F365 with Blackpink"],", the motions of a cat and King Kong were used to describe ",["em","How You Like That"],". In what aspects do they represent the song?"],["p","“When we think of the title and lyrics for “How You Like That”, we imagine a sharp cat scratch. There’s a part in the song where the explosive drop whirls together with the powerful beat, and the image of King Kong came to mind.”"],["h2","What kind of group is Blackpink in 2020 compared to 2019?"],["p","“2019 was definitely an unforgettable year that brought us great joy. We were able to perform at bigger stages, meet countless people, and we definitely grew and matured from it. We still say, ‘Did those things really happen to us?‘ Being able to meet our fans in person and see them enjoy and love our music gave us more responsibility as a group to show them a better and more advanced Blackpink.”"],["inline-embed",{"props":{"dangerousCaption":"","dangerousCredit":"","image":{"id":"5ef5c7b230b96d1985f4fd5f","altText":"Image may contain Clothing Apparel Human Person and Kisum","contentType":"photo","sources":{"sm":{"width":320,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_320,c_limit\u002FBP_1.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_120,c_limit\u002FBP_1.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_240,c_limit\u002FBP_1.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_320,c_limit\u002FBP_1.jpg 320w","height":173},"md":{"width":640,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_640,c_limit\u002FBP_1.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_120,c_limit\u002FBP_1.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_240,c_limit\u002FBP_1.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_320,c_limit\u002FBP_1.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_640,c_limit\u002FBP_1.jpg 640w","height":346},"lg":{"width":960,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_960,c_limit\u002FBP_1.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_120,c_limit\u002FBP_1.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_240,c_limit\u002FBP_1.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_320,c_limit\u002FBP_1.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_640,c_limit\u002FBP_1.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_768,c_limit\u002FBP_1.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_960,c_limit\u002FBP_1.jpg 960w","height":519},"xl":{"width":1200,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_1200,c_limit\u002FBP_1.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_120,c_limit\u002FBP_1.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_240,c_limit\u002FBP_1.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_320,c_limit\u002FBP_1.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_640,c_limit\u002FBP_1.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_768,c_limit\u002FBP_1.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_960,c_limit\u002FBP_1.jpg 960w","height":648},"xxl":{"width":1600,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_1600,c_limit\u002FBP_1.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_120,c_limit\u002FBP_1.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_240,c_limit\u002FBP_1.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_320,c_limit\u002FBP_1.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_640,c_limit\u002FBP_1.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_768,c_limit\u002FBP_1.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_960,c_limit\u002FBP_1.jpg 960w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_1280,c_limit\u002FBP_1.jpg 1280w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b230b96d1985f4fd5f\u002Fmaster\u002Fw_1600,c_limit\u002FBP_1.jpg 1600w","height":864}}}},"level":"block","ref":"5ef5c7b230b96d1985f4fd5f","type":"image"}],["ad",{"position":"mid-content"}],["h2","Are you finding the recording process is changing as you grow as artists? What’s the dynamic in the studio between the four of you?"],["p","“Our studio sessions are always so much fun. The recording process isn’t that different from before — we play, chat, eat good food, share our favourite music and ideas. There’s a natural flow so everyone is comfortable enough to fully understand the music and digest their own parts, which is how we have been able to be content with our final products.”"],["h2","Lady Gaga mentioned she’d reached out to you for the “Sour Candy” collaboration. Did you video chat with her, and what did you talk about?"],["p","“We spoke with Lady Gaga over a phone call and she said that she liked our unique characteristics as a group. We’ve all really liked Lady Gaga since before our debut days, so it was a huge honour for us to be able to work with her. It was a very fun project and we hope everyone can enjoy it!”"],["h2","As music has become more globally available, audience demand for non-English speaking pop stars has risen. What do you think of these opportunities to collaborate?"],["p","“We think collaboration is mutually beneficial. Through musical exchanges, we can inspire and be inspired, and it can be a new stimulus as well. Working with artists whose music is different to ours provides a good synergy.”"],["h2","Korean artists are now global superstars breaking many boundaries — how do you believe that’s happened?"],["p","“First of all, we’re so grateful. With the development of so many different media platforms, music has become much more global. We think this is the biggest factor as to why K-pop is loved by so many people. With good music, language barriers and cultural differences are not a problem. That’s when we feel that music truly is universal.”"],["ad",{"position":"mid-content"}],["h2","Most people make mistakes but, as celebrities, even the smallest error could be impactful on you and your career. How does this affect how you live, the decisions that you make, or the things you seek to experience?"],["p","“When it comes to our decisions, our life, and our careers, it impacts all of us. As public figures, it is true that our lives tend to be more exposed and focused on. But regardless of that, as individuals, we want to take responsibility for our actions and decisions.”"],["h2","Having been a band for four years now, what aspect of the job remains difficult, and what has become much easier?"],["p","“The creative aspect of it is always joyful, but it’s still a tough job. We can’t just stop here, and we need to continually show our progression as a group, but through that process we find new ways to develop ourselves further. Because of our fans who show so much love and support, we can approach new challenges with peace of mind.”"],["inline-embed",{"props":{"dangerousCaption":"","dangerousCredit":"","image":{"id":"5ef5c7b330b96d1985f4fd60","altText":"Image may contain Clothing Apparel Sleeve Human Person Pants Long Sleeve Denim and Jeans","contentType":"photo","sources":{"sm":{"width":320,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_320,c_limit\u002FBP_2.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_120,c_limit\u002FBP_2.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_240,c_limit\u002FBP_2.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_320,c_limit\u002FBP_2.jpg 320w","height":219},"md":{"width":640,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_640,c_limit\u002FBP_2.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_120,c_limit\u002FBP_2.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_240,c_limit\u002FBP_2.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_320,c_limit\u002FBP_2.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_640,c_limit\u002FBP_2.jpg 640w","height":438},"lg":{"width":960,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_960,c_limit\u002FBP_2.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_120,c_limit\u002FBP_2.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_240,c_limit\u002FBP_2.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_320,c_limit\u002FBP_2.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_640,c_limit\u002FBP_2.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_768,c_limit\u002FBP_2.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_960,c_limit\u002FBP_2.jpg 960w","height":657},"xl":{"width":1200,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_1200,c_limit\u002FBP_2.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_120,c_limit\u002FBP_2.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_240,c_limit\u002FBP_2.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_320,c_limit\u002FBP_2.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_640,c_limit\u002FBP_2.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_768,c_limit\u002FBP_2.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_960,c_limit\u002FBP_2.jpg 960w","height":821},"xxl":{"width":1600,"url":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_1600,c_limit\u002FBP_2.jpg","srcset":"https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_120,c_limit\u002FBP_2.jpg 120w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_240,c_limit\u002FBP_2.jpg 240w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_320,c_limit\u002FBP_2.jpg 320w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_640,c_limit\u002FBP_2.jpg 640w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_768,c_limit\u002FBP_2.jpg 768w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_960,c_limit\u002FBP_2.jpg 960w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_1280,c_limit\u002FBP_2.jpg 1280w, https:\u002F\u002Fmedia.vogue.co.uk\u002Fphotos\u002F5ef5c7b330b96d1985f4fd60\u002Fmaster\u002Fw_1600,c_limit\u002FBP_2.jpg 1600w","height":1095}}}},"level":"block","ref":"5ef5c7b330b96d1985f4fd60","type":"image"}],["ad",{"position":"mid-content"}],["h2","What did you take away from experiences like Coachella and your US TV appearances? Were there a lot of nerves or stresses?"],["p","“We were so nervous because it was our first face-to-face experience with such a huge crowd in the States. We definitely felt the stress and pressure to showcase who we were as Blackpink for the first time. But as soon as we stepped onto the stage, the crowd enjoyed our songs beyond the language, and all our worries disappeared. We still have so much to learn but we learned how to vibe with the crowd and enjoy our performance a bit more.”"],["h2","What’s the most important thing you’ve learnt about yourself, being members of such a wildly successful group?  "],["p","“We think the most important thing is not to be complacent [and to keep on] showing a new side of yourself. It’s important to have confidence with the music and visuals we want to show. We have to trust ourselves in order for people who see us to trust us.”"],["h2","As a group, you’ve returned to a world that looks very different from when you last released material. Your fans will have directly or indirectly been affected by the Covid-19 pandemic — what’s your message to Blinks?"],["p","“It’s a difficult time for all of us and we hope everyone can be supportive of one another. We want to send positive vibes and energy through our music in the hopes of brightening up your day."],["p","“Besides preparing for our comeback, we were careful treating our health and safety as our main concern. Meeting Blinks online and talking to them gave us joy and encouragement.”"],["h2","You must know each other inside out by now, but what do you learn about each other as time goes on that surprises you?"],["p","“We’ve known each other for about nine years now. We feel like a family and we know so much about each other that there are no more surprises. One thing all four of us agree on is that we all have the same level of affection for our work. That is why we can always support each other, encourage each other, and work together for a better future for Blackpink.”"],["ad",{"position":"mid-content"}],["h2","Your fame and influence is huge — how do you take care of your mental wellbeing when you’re under such intense scrutiny?"],["p","“With fame and influence comes more responsibility. We gain strength from Blinks all over the world and by always relying on each other.”"],["h2","What message would you like people who listen to your music to take away with them?"],["p","“We wish to give a hopeful and positive message through our music to everyone. And we want our Blinks to have strength and confidence instead of giving up in dark times.”"],["h2","What’s the best thing about being in Blackpink?"],["p","“Being able to make memories and accomplishments with the help of our lovely fans, our label and staff and, of course, all of the members, with amazing music.”"],["p",["em","More from British Vogue…"]],["inline-embed",{"props":{"dangerousCaption":"","height":"","scriptUrl":"https:\u002F\u002Fplayer.cnevids.com\u002Fscript\u002Fvideo\u002F60c2ac147c16658301d89d44.js?aspectRatio=16x9&autoplay=0&muted=0","width":""},"level":"block","ref":"","type":"cneembed"}]],"pageStructure":[["p",64],["inline-embed",0,"article"],["p",68],["cm-unit",0],["p",65],["inline-embed",-100,"cneinterlude"],["p",42],["native-ad",0],["inline-embed",200,"image"],["ad",0],["h2",14],["p",43],["h2",36],["p",44],["h2",11],["p",72],["inline-embed",200,"image"],["ad",0],["h2",24],["p",62],["h2",25],["p",60],["h2",25],["p",37],["h2",16],["p",59],["ad",0],["h2",38],["p",49],["h2",21],["p",62],["inline-embed",200,"image"],["ad",0],["h2",22],["p",82],["h2",17],["p",50],["h2",37],["p",37],["p",29],["h2",24],["p",70],["ad",0],["h2",22],["p",23],["h2",16],["p",31],["h2",8],["p",28],["p",4],["inline-embed",200,"cneembed"]],"adCount":{"cm":1,"native":1,"mid_content":5,"interlude":1},"remainingWordCount":0,"hasAffiliateLinks":false,"affiliateLinksCount":0,"isCommerceContent":false,"contributorSpotLightProps":{"header":{"name":"Taylor Glasby","title":" ","url":"\u002Fprofile\u002Ftaylor-glasby","